{
    "params": {
        "input": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/m4i",
            "schema": "eur2"
        },
        "output": {
            "connector": "DBWriter",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/m4i",
            "schema": "eur2_output"
        },
        "modes": "modes",
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    {
                        "src": "mat",
                        "filters": " day_type = '{day_type_simulation}' and mode = 'c' "
                    }
                ]
            }
        ],
        "zones": {
            "src": "zones",
            "mapping": {
                "geometry": "geom"
            }
        },
        "supply": [
            {
                "links": {
                    "src": "links",
                    "mapping": {
                        "geometry": "geom"
                    }
                },
                "nodes": {
                    "src": "nodes",
                    "mapping": {
                        "geometry": "geom"
                    }
                },
                "turns": {
                    "src": "turns"
                }
            }
        ],
        "links_sets": ["links_sets"],
        "events": [
            {
                "src": "events"
            }
        ],
        "detectors": [
            {
                "src": "detectors",
                "mapping": {
                    "id": "id",
                    "id_link": "id_link"
                }
            }
        ],
        "counts": [
            {
                "src": "counts"
            }
        ],
        "traffic_lights": [
            {
                "src": "traffic_lights"
            }
        ],
        "aggregated_results": {
            "src": "aggregated_results",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from aggregated_results where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "trace_results": {
            "src": "trace_results",
            "additional_fields": { "simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from trace_results where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "paths": {
            "src": "paths",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from paths where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "aggregated_results_stats": {
            "src": "aggregated_results_stats",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from aggregated_results_stats where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "signal_results": {
            "src": "signal_results",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from signal_results where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "statistics": {
            "src": "statistics",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from statistics where simulation_id = {simulation_id}"
        },
        "params": {
            "src": "params",
            "additional_fields": {"day_type": { "value": "{day_type_simulation}", "dtype": "string" }, "simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from params where simulation_id = {simulation_id}"
        },        
        "fcd_paths": {
            "src": "fcd_paths",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from fcd_paths where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "fcd_paths_clustered": {
            "src": "fcd_paths_clustered",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from fcd_paths_clustered where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },        
        "fcd_trips": {
            "src": "fcd_trips",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "pre_query": "delete from fcd_trips where simulation_id = {simulation_id}",
            "mapping": {
                "geometry": "geom"
            }
        },
        "fcd_fcd": {
            "src": "fcd_fcd",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "partition_cols": ["day_type"],
            "mapping": {
                "geometry": "geom"
            }
        },
        "fcd_graph": {
            "src": "fcd_graph",
            "additional_fields": {"simulation_id": { "value": "{simulation_id}", "dtype": "long" }},
            "partition_cols": ["day_type","t_base"]
        },
        "state": {
            "connector": "FileLoader",
            "location": "./dati/{scenario}/files",
            "src": "state"
        },
        "fcd": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/fcd_mobito",
            "src": "eur.fcdmm",
            "index_col": "id_fcd",
            "crs": "EPSG:4326",
            "tz_data": "UTC",
            "mapping": {
                "id_fcd": "id_fcd",
                "id_veh": "id_trip",
                "heading": "heading",
                "timestamp": "dt",
                "engine": "engine",
                "speed": "speed",
                "lon": "lon",
                "lat": "lat",
                "geometry": "geometry"
            }
        }
    }
}