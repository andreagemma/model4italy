{
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/{scenario}/files"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{scenario}/{simulation_id}"
        },
        "modes": [
            {
                "code": "c",
                "description": "car",
                "eq_factor": 1
            },
            {
                "code": "h",
                "description": "heavy",
                "eq_factor": 2
            }
        ],
        "supply": [
            {
                "links": {
                    "src": "links.shp",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "length": "length",
                        "v0": "v0",
                        "connector": "connector",
                        "lanes": "lanes",
                        "alpha": "alpha",
                        "rcr": "rcr",
                        "capacity": "capacity",
                        "modes": "modes"
                    }
                },
                "nodes": { "src":
                    "nodes.shp",
                    "mapping": {
                        "id": "id",
                        "centroid": "centroid",
                        "modes": "modes",
                        "geometry": "geometry"
                    }
                },
                "turns": {
                    "src": "turns.csv",
                    "mapping": {
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "via_node": "via_node",
                        "penalty": "penalty",
                        "modes": "modes"
                    }
                }
            }
        ]        
    }
}