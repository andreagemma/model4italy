{
    "one": 0,
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/{scenario}/files"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{scenario}/{simulation_id}"
        },
        "modes": [
            {
                "code": "c",
                "description": "car",
                "eq_factor": 1
            },
            {
                "code": "n",
                "description": "no ztl",
                "eq_factor": 1
            },{
                "code": "z",
                "description": "ztl",
                "eq_factor": 1
            }
        ],
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    {
                        "src": "mat.parquet",
                        "mapping": {
                            "o": "o",
                            "d": "d",
                            "timestamp": "timestamp",
                            "value": "value"
                        }
                    }
                ]
            }
        ],
        "zones": {
            "src": "zones.gpkg",
            "mapping": {
                "id": "id",
                "geometry": "geometry"
            }
        },
        "supply": [
            {
                "links": {
                    "src": "links.gpkg",
                    "layer": "links",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "length": "length",
                        "v0": "v0",
                        "connector": "connector",
                        "lanes": "lanes",
                        "alpha": "alpha",
                        "rcr": "rcr",
                        "capacity": "capacity",
                        "modes": "modes",
                        "name": "name",
                        "geometry": "geometry"
                    }
                },
                "nodes": { 
                    "src": "nodes.gpkg",
                    "layer": "nodes",
                    "mapping": {
                        "id": "id",
                        "centroid": "centroid",
                        "modes": "modes",
                        "geometry": "geometry"
                    }
                },
                "turns": {
                    "src": "turns.csv",
                    "mapping": {
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "via_node": "via_node",
                        "penalty": "penalty",
                        "modes": "modes"
                    }
                }
            }
        ],
        "aggregated_results": "aggregated_results.gpkg",
        "trace_results": "trace_results.gpkg",
        "paths": "paths.gpkg",
        "aggregated_results_stats": "aggregated_results_stats.csv",
        "signal_results": "signal_results.gpkg",
        "statistics": "statistics.csv",
        "params": "params.json",        
        "fcd_paths": "fcd_paths.gpkg",
        "fcd_graph": "fcd_graph.gpkg",
        "state": "state",
        "fcd": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/fcd_mobito",
            "src": "sc_rm.fcd",
            "index_col": "id_fcd",
            "crs": "EPSG:4326",
            "tz_data": "UTC",
            "mapping": {
                "id_fcd": "id_fcd",
                "id_veh": "id_trip",
                "heading": "heading",
                "timestamp": "dt",
                "engine": "engine",
                "speed": "speed",
                "lon": "lon",
                "lat": "lat",
                "geometry": "geometry"
            }
        }
    }
}