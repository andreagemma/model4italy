{
    "one": 0,
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/eur2/files"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{description}/{scenario_id}"
        },
        "modes": [
            {
                "id": "c",
                "description": "car",
                "eq_factor": 1
            },
            {
                "id": "h",
                "description": "heavy",
                "eq_factor": 2
            }
        ],
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    {
                        "src": "mat_car.parquet",
                        "mapping": {
                            "o": "o",
                            "d": "d",
                            "timestamp": "timestamp",
                            "value": "value"
                        }
                    }
                ]
            }
        ],
        "zones": {
            "src": "zones.shp",
            "mapping": {
                "id": "id",
                "geometry": "geometry"
            }
        },
        "supply": [
            {
                "links": {
                    "src": "links.shp",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "length": "length",
                        "v0": "v0",
                        "connector": "connector",
                        "lanes": "lanes",
                        "alpha": "alpha",
                        "rcr": "rcr",
                        "capacity": "capacity",
                        "modes": "modes"
                    }
                },
                "nodes": { "src":
                    "nodes.shp",
                    "mapping": {
                        "id": "id",
                        "centroid": "centroid",
                        "modes": "modes",
                        "geometry": "geometry"
                    }
                },
                "turns": {
                    "src": "turns.csv",
                    "mapping": {
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "via_node": "via_node",
                        "penalty": "penalty",
                        "modes": "modes"
                    }
                }
            }
        ],
        "links_sets": [
            {
                "src": "links_sets.csv",
                "mapping": {
                    "id_set": "id_set",
                    "id_link": "id_link"
                }
            }
        ],
        "events_no": [
            {
                "src": "events.csv",
                "mapping": {
                    "id_link_set": "id_link_set",
                    "type": "type",
                    "start": "start",
                    "end": "end",
                    "params": "params"
                }
            }
        ],
        "detectors": [
            {
                "src": "detectors.shp",
                "mapping": {
                    "id": "id",
                    "id_link": "id_link"
                }
            }
        ],
        "counts": [
            {
                "src": "counts.csv",
                "mapping": {
                    "id": "id",
                    "timestamp": "timestamp",
                    "mode": "mode",
                    "counts": "counts"
                }
            }
        ],        
        "traffic_lights": [
            {
                "src": "traffic_lights.csv",
                "crs": "EPSG:4326",
                "mapping": {
                    "id": "id",
                    "cycle": "cycle",
                    "offset": "offset",
                    "phases": "phases",
                    "geometry":"geometry"
                }
            }
        ],
        "aggregated_results": "aggregated_results_{simulation_id}.geoparquet",
        "paths": "path_{simulation_id}.geoparquet",
        "fcd_paths": {
            "src": "fcd_paths.geoparquet",
            "additional_fields": {
                "day_type": "{day_type_simulation}"
            }
        },
        "fcd_paths_clustered": {
            "src": "fcd_paths_clustered.geoparquet"            
        },
        "fcd_trips": {
            "src": "fcd_trips.geoparquet",
            "additional_fields": {
                "day_type": "{day_type_simulation}"
            },
            "mode": "wa"
        },
        "fcd_fcd_": {
            "src": "fcd_fcd.geoparquet",
            "partition_cols": [
                "day_type",
                "t"
            ],
            "additional_fields": {
                "day_type": "{day_type_simulation}",
                "mode": "wa"
            }
        },
        "fcd_graph": {
            "src": "fcd_graph.parquet",
            "partition_cols": [
                "day_type",
                "t_base"
            ],
            "additional_fields": {
                "day_type": "{day_type_simulation}",
                "mode": "wa"
            }
        },
        "statistics": "stats.csv",
        "state": "state",
        "params": "../params_{simulation_id}.json",
        "fcd": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/fcd_mobito",
            "src": "eur.fcdmm",
            "index_col": "id_fcd",
            "crs": "EPSG:4326",
            "tz_data": "UTC",
            "mapping": {
                "id_fcd": "id_fcd",
                "id_veh": "id_trip",
                "heading": "heading",
                "timestamp": "dt",
                "engine": "engine",
                "speed": "speed",
                "lon": "lon",
                "lat": "lat",
                "geometry": "geometry"
            }
        }
    }
}