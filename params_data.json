{
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/eur/files"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{description}"            
        },
        "modes": [
            {
                "id": "c",
                "description": "car",
                "eq_factor": 1
            },
            {
                "id": "h",
                "description": "heavy",
                "eq_factor": 2
            }
        ],
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    "mat_car.parquet"
                ]
            }
        ],
        "zones": "zones.shp",
        "supply": [
            {
                "links": {
                    "src":  "eur_links.shp",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "v0": "v0",
                        "connector": "connect",
                        "lanes": "n_lanes"
                    }
                },
                "nodes": "eur_nodes.shp",
                "turns": {
                    "src": "turns_proh.csv",
                    "mapping": {
                        "from_node": "fromnodeno",
                        "to_node": "tonodeno",
                        "via_node": "vianodeno"
                    }
                }
            }
        ],
        "links_sets": [ {
            "src": "links_sets.csv",
            "mapping": {
                "set": "id_set",
                "id_link": "id_link"
            }
        }],
        "events_no": [{
            "src": "events.csv",
            "mapping": {
                "id_link_set": "id",
                "type": "type",
                "start": "start",
                "end": "end",
                "params": "params"
            }
        }],
        "detectors": [{
            "src": "detectors.shp",
            "mapping": {
                "id": "id"
            }
        }],
        "traffic_lights": [ 
            {
                "src": "sign_nodes.json",
                "mapping": {
                    "id": "id",
                    "type": "type",
                    "phases": "phases"
                }
            }
        ],
        "aggregated_results": "{simulation_id}_aggregated_results.parquet",
        "paths": "{simulation_id}_paths.parquet",
        "rt_paths": "{simulation_id}_rt_paths.parquet",        
        "statistics": "{simulation_id}_stats.csv", 
        "state": "./dati/output/{description}/state",
        "fcd": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/fcd_mobito",
            "src": "eur.fcdmm",
            "crs": "EPSG:4326",
            "tz_data": "Etc/UTC",
            "mapping": {
                "id_fcd": "id_fcd",
                "id_trip": "id_trip",
                "heading": "heading",
                "timestamp": "dt",
                "engine": "engine",
                "speed": "speed",
                "lon": "lon",
                "lat": "lat",
                "geometry": "geometry"
            }
        }
    }
}
