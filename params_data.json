{
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/eur2/files"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{description}/{simulation_id}"            
        },
        "modes": [
            {
                "id": "c",
                "description": "car",
                "eq_factor": 1
            },
            {
                "id": "h",
                "description": "heavy",
                "eq_factor": 2
            }
        ],
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    "mat_car.parquet"
                ]
            }
        ],
        "zones": "zones.shp",
        "supply": [
            {
                "links": {
                    "src":  "eur_links.shp",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "v0": "v0",
                        "connector": "connect",
                        "lanes": "n_lanes"
                    }
                },
                "nodes": "eur_nodes.shp",
                "turns": {
                    "src": "turns_proh.csv",
                    "mapping": {
                        "from_node": "fromnodeno",
                        "to_node": "tonodeno",
                        "via_node": "vianodeno"
                    }
                }
            }
        ],
        "links_sets": [ {
            "src": "links_sets.csv",
            "mapping": {
                "set": "id_set",
                "id_link": "id_link"
            }
        }],
        "events_no": [{
            "src": "events.csv",
            "mapping": {
                "id_link_set": "id",
                "type": "type",
                "start": "start",
                "end": "end",
                "params": "params"
            }
        }],
        "detectors": [{
            "src": "detectors.shp",
            "mapping": {
                "id": "id"
            }
        }],
        "traffic_lights": [ 
            {
                "src": "sign_nodes.json",
                "mapping": {
                    "id": "id",
                    "type": "type",
                    "phases": "phases"
                }
            }
        ],
        "aggregated_results": { "src": "aggregated_results.parquet", "partition_cols": ["t"] },
        "paths":"path.parquet",
        "fcd_paths": { "src": "fcd_paths.geoparquet", "partition_cols": ["day_type", "t"], "mapping": {"day_type": "{day_type_simulation}"}, "mode":"wa"},
        "fcd_trips_": { "src": "fcd_trips.geoparquet", "partition_cols": ["day_type", "t"], "mapping": {"day_type": "{day_type_simulation}"}, "mode":"wa" },
        "fcd_fcd_": { "src": "fcd_fcd.geoparquet", "partition_cols": ["day_type", "t"], "mapping": {"day_type": "{day_type_simulation}", "mode":"wa"}},
        "fcd_graph": { "src": "fcd_graph.parquet", "partition_cols": ["day_type", "t_base"], "mapping": {"day_type": "{day_type_simulation}", "mode":"wa"}},
        "statistics": "stats.csv", 
        "state": "./dati/output/{description}/state",
        "params": "../params_{simulation_id}.json", 
        "fcd": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/fcd_mobito",
            "src": "eur.fcdmm",
            "index_col": "id_fcd",
            "crs": "EPSG:4326",
            "tz_data": "UTC",
            "mapping": {
                "id_fcd": "id_fcd",
                "id_veh": "id_trip",
                "heading": "heading",
                "timestamp": "dt",
                "engine": "engine",
                "speed": "speed",
                "lon": "lon",
                "lat": "lat",
                "geometry": "geometry"
            }
        }
    }
}
