{
    "one": 0,
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/cav"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{description}/{scenario_id}"
        },
        "modes": [
            {
                "id": "c",
                "description": "car",
                "eq_factor": 1
            }
        ],
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    {
                        "src": "mat_car.parquet",
                        "mapping": {
                            "o": "o",
                            "d": "d",
                            "timestamp": "timestamp",
                            "value": "value"
                        }
                    }
                ]
            }
        ],
        "zones": {
            "src": "zones.shp",
            "mapping": {
                "id": "id",
                "geometry": "geometry"
            }
        },
        "supply": [
            {
                "links": {
                    "src": "links.shp",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "length": "length",
                        "v0": "v0",
                        "connector": "connector",
                        "lanes": "lanes",
                        "alpha": "alpha",
                        "rcr": "rcr",
                        "capacity": "capacity",
                        "modes": "modes"
                    }
                },
                "nodes": { "src": "nodes.shp",
                    "mapping": {
                        "id": "id",
                        "centroid": "centroid",
                        "modes": "modes",
                        "geometry": "geometry"
                    }
                },
                "turns": {
                    "src": "turns.csv",
                    "mapping": {
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "via_node": "via_node",
                        "penalty": "penalty",
                        "modes": "modes"
                    }
                }
            }
        ],
        "links_sets_no": [
            {
                "src": "links_sets.csv",
                "mapping": {
                    "id_set": "id_set",
                    "id_link": "id_link"
                }
            }
        ],
        "events_no": [
            {
                "src": "events.csv",
                "mapping": {
                    "id_link_set": "id_link_set",
                    "type": "type",
                    "start": "start",
                    "end": "end",
                    "params": "params"
                }
            }
        ],
        "detectors": [
            {
                "src": "detectors.shp",
                "mapping": {
                    "id": "id",
                    "id_link": "id_link"
                }
            }
        ],
        "counts": [
            {
                "src": "counts.csv",
                "mapping": {
                    "id": "id",
                    "timestamp": "timestamp",
                    "mode": "mode",
                    "counts": "counts"
                }
            }
        ],        
        "traffic_lights_no": [
            {
                "src": "traffic_lights.csv",
                "crs": "EPSG:4326",
                "mapping": {
                    "id": "id",
                    "cycle": "cycle",
                    "offset": "offset",
                    "phases": "phases",
                    "geometry":"geometry"
                }
            }
        ],
        "aggregated_results": {
            "src": "aggregated_results_{simulation_id}.parquet",
            "partition_cols": ["t"]
        },
        "paths": "path_{simulation_id}.geoparquet",
        "statistics": "stats.csv",
        "state": "state",
        "params": "../params_{simulation_id}.json"
    }
}