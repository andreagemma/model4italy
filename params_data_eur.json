{
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./data/{scenario}"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./data/{scenario}/output/{simulation_id}"
        },
        "modes": "modes.csv",
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    {
                        "src": "mat_weekday_c.csv"
                    }
                ]
            }
        ],
        "zones": "zones.shp",
        "supply": [
            {
                "links": {
                    "src": "links.shp"                    
                },
                "nodes": {
                    "src": "nodes.shp"
                },
                "turns": {
                    "src": "turns.csv"
                }
            }
        ],
        "links_sets": ["links_sets.csv"],
        "events_no": [
            {
                "src": "events.csv",
                "mapping": {
                    "id_link_set": "id_link_set",
                    "type": "type",
                    "start": "start",
                    "end": "end",
                    "params": "params"
                }
            }
        ],
        "traffic_lights": [
            {
                "src": "traffic_lights.gpkg",
                "layer": "traffic_lights",
                "mapping": {
                    "id": "id",
                    "cycle": "cycle",
                    "offset": "offset",
                    "phases": "phases",
                    "geometry": "geometry"
                }
            }
        ],
        "aggregated_results": "aggregated_results.geoparquet",            
        "trace_results": "trace_results.geoparquet",
        "paths": "paths.geoparquet",
        "aggregated_results_stats": "aggregated_results_stats.csv",
        "signal_results": "signal_results.geoparquet",
        "statistics": "statistics.csv",
        "params": "params.json",        
        "fcd_paths": {
            "src": "fcd_paths.geoparquet",
            "additional_fields": {"day_type": { "value": "{day_type_simulation}", "dtype": "string" }},            
            "partition_cols": ["day_type","t"]
        },
        "fcd_paths_clustered": {
            "src": "fcd_paths_clustered.geoparquet"
        },        
        "fcd_trips": {
            "src": "fcd_trips.geoparquet",
            "additional_fields": {"day_type": { "value": "{day_type_simulation}", "dtype": "string" }},
            "partition_cols": ["day_type","t"]
        },
        "fcd_fcd": {
            "src": "fcd_fcd.geoparquet",
            "additional_fields": {"day_type": { "value": "{day_type_simulation}", "dtype": "string" }},
            "partition_cols": ["day_type"]
        },
        "fcd_graph": {
            "src": "fcd_graph.parquet",
            "additional_fields": {"day_type": { "value": "{day_type_simulation}", "dtype": "string" }},
            "partition_cols": ["day_type","t_base"]
        },
        "state": "state",
        "fcd": {
            "connector": "DBLoader",
            "location": "postgresql+psycopg://postgres:lDvdc15dcd5@192.168.133.80:5432/fcd_mobito",
            "src": "eur.fcdmm",
            "index_col": "id_fcd",
            "crs": "EPSG:4326",
            "tz_data": "UTC",
            "mapping": {
                "id_fcd": "id_fcd",
                "id_veh": "id_trip",
                "heading": "heading",
                "timestamp": "dt",
                "engine": "engine",
                "speed": "speed",
                "lon": "lon",
                "lat": "lat",
                "geometry": "geometry"
            }
        }
    }
}
