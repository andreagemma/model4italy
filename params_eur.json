{
    "simulation_id": 1,
    "scenario": "eur2",
    "start": "07:00",
    "end": "07:30",  
    "op": "assignment",
    "settings": {
        "MSA_MAX_ITE": 6,
        "MSA_K": 2
    },
    "params": {
        "input": {
            "connector": "FileLoader",
            "location": "./dati/{scenario}/files"
        },
        "output": {
            "connector": "FileWriter",
            "location": "./dati/output/{scenario}/{simulation_id}"
        },
        "modes": [
            {
                "code": "c",
                "description": "car",
                "eq_factor": 1
            },
            {
                "code": "h",
                "description": "heavy",
                "eq_factor": 2
            }
        ],
        "demand": [
            {
                "mode": "c",
                "matrices": [
                    {
                        "src": "mat_car.csv",
                        "mapping": {
                            "o": "o",
                            "d": "d",
                            "timestamp": "timestamp",
                            "value": "value"
                        }
                    }
                ]
            },{
                "mode": "h",
                "matrices": [
                    {
                        "src": "mat_heavy.csv",
                        "mapping": {
                            "o": "o",
                            "d": "d",
                            "timestamp": "timestamp",
                            "value": "value"
                        }
                    }
                ]
            }
        ],
        "zones": {
            "src": "zones.shp",
            "mapping": {
                "id": "id",
                "geometry": "geometry"
            }
        },
        "supply": [
            {
                "links": {
                    "src": "links.shp",
                    "mapping": {
                        "id": "id",
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "length": "length",
                        "v0": "v0",
                        "connector": "connector",
                        "lanes": "lanes",
                        "alpha": "alpha",
                        "rcr": "rcr",
                        "capacity": "capacity",
                        "modes": "modes"
                    }
                },
                "nodes": { "src":
                    "nodes.shp",
                    "mapping": {
                        "id": "id",
                        "centroid": "centroid",
                        "modes": "modes",
                        "geometry": "geometry"
                    }
                },
                "turns": {
                    "src": "turns.csv",
                    "mapping": {
                        "from_node": "from_node",
                        "to_node": "to_node",
                        "via_node": "via_node",
                        "penalty": "penalty",
                        "modes": "modes"
                    }
                }
            }
        ],
        "links_sets": [
            {
                "src": "links_sets.csv",
                "mapping": {
                    "id_set": "id_set",
                    "id_link": "id_link"
                }
            }
        ],
        "events": [
            {
                "src": "events.csv",
                "mapping": {
                    "id_link_set": "id_link_set",
                    "type": "type",
                    "start": "start",
                    "end": "end",
                    "params": "params"
                }
            }
        ],
        "detectors": [
            {
                "src": "detectors.shp",
                "mapping": {
                    "id": "id",
                    "id_link": "id_link"
                }
            }
        ],
        "counts": [
            {
                "src": "counts.csv",
                "mapping": {
                    "id": "id",
                    "timestamp": "timestamp",
                    "mode": "mode",
                    "counts": "counts"
                }
            }
        ],
        "traffic_lights": [
            {
                "src": "traffic_lights.gpkg",
                "layer": "traffic_lights",
                "mapping": {
                    "id": "id",
                    "cycle": "cycle",
                    "offset": "offset",
                    "phases": "phases",
                    "geometry": "geometry"
                }
            }
        ],
        "aggregated_results": "aggregated_results.gpkg",
        "trace_results": "trace_results.gpkg",
        "paths": "paths.gpkg",
        "aggregated_results_stats": "aggregated_results_stats.csv",
        "signal_results": "signal_results.gpkg",
        "statistics": "statistics.csv",
        "params": "params.json"
    }
}
